# ============================================
# 环境变量模板 —— 复制为 .env 后填写真实值
# ⚠️ 本文件不含任何真实凭证，仅作格式参考
# 密码含特殊字符时必须用单引号包裹（如 '$Abc@123&x,:')
# ============================================

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_NAME=client_service

# ===== SMTP 配置（400cz 对外收发）=====
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=465
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM=客户服务申请系统 <CHANGE_ME_SMTP_USER>

# ===== IMAP 配置（400cz 回件监控）=====
IMAP_HOST=CHANGE_ME_IMAP_HOST
IMAP_PORT=993
IMAP_USER=CHANGE_ME_IMAP_USER
IMAP_PASS=CHANGE_ME_IMAP_PASS

# ===== 入站监控（中转邮箱 cz）=====
INBOUND_IMAP_HOST=CHANGE_ME_INBOUND_HOST
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=CHANGE_ME_INBOUND_USER
INBOUND_IMAP_PASS=CHANGE_ME_INBOUND_PASS
INBOUND_ALLOWED_SENDERS=CHANGE_ME_ALLOWED_SENDER

# ===== 邮箱（售后/兜底）=====
SUPPORT_EMAIL=support@example.com
FALLBACK_EMAIL=fallback@example.com

# ===== 附件清理（每天执行）=====
CLEAN_INTERVAL=86400000          # 清理周期（毫秒），默认 24h
CLEAN_EXPIRED_ENABLED=true       # 是否清理"已完成申请"的超期附件
CLEAN_EXPIRED_DAYS=1             # 已完成申请附件保留天数
CLEAN_MAX_PER_RUN=500            # 单次最多清理文件数

# ===== CORS 白名单（逗号分隔）=====
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# ===== HTTPS（可选，配置后启用 https，否则 http）=====
# 方式一：PEM 证书
# SSL_CERT=/path/to/server.crt
# SSL_KEY=/path/to/server.key
# 方式二：PFX 证书
# SSL_PFX=/path/to/server.pfx
# SSL_PASS=证书密码

# ===== 后端端口 =====
PORT=3002

# ===== relay（前端发信中继，公网）=====
RELAY_SMTP_HOST=CHANGE_ME_RELAY_HOST
RELAY_SMTP_PORT=465
RELAY_SMTP_USER=CHANGE_ME_RELAY_USER
RELAY_SMTP_PASS=CHANGE_ME_RELAY_PASS
RELAY_TO=CHANGE_ME_RELAY_TO
RELAY_SMTP_FROM="客户服务申请系统" <CHANGE_ME_RELAY_USER>
RELAY_ALLOWED_ORIGINS=http://localhost:3001
RELAY_MAX_PER_MIN=20
RELAY_PORT=3003
